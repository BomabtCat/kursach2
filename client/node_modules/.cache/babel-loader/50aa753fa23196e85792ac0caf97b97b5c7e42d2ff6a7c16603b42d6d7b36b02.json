\", \"/\"],\n  [\"Оборудование\", \"/assets\"],\n  [\"Сотрудники\", \"/employees\"],\n  [\"Отделы\", \"/departments\"],\n  [\"Инциденты\", \"/incidents\"],\n  [\"Обслуживание\", \"/maintenance\"],\n  [\"Поставщики\", \"/vendors\"],\n  [\"Профиль\", \"/profile\"]\n];\n\nexport default function Layout({ children }) {\n  const { user, logout, toast, setToast } = useAuth();\n\n  return (\n    <div className=\"shell\">\n      <aside className=\"sidebar\">\n        <div className=\"brand\">IT Infra</div>\n        <nav>\n          {nav.map(([label, to]) => (\n            <NavLink key={to} to={to} end={to === \"/\"}>\n              {label}\n            </NavLink>\n          ))}\n        </nav>\n      </aside>\n      <div className=\"workspace\">\n        <header className=\"topbar\">\n          <div>\n            <strong>{user?.username}</strong>\n            <span>{user?.role}</span>\n          </div>\n          <button className=\"secondary\" onClick={logout}>Выйти</button>\n        </header>\n        <section className=\"content\">{children}</section>\n      </div>\n      {toast && (\n        <button className={`toast ${toast.type}`} onClick={() => setToast(null)}>\n          {toast.text}\n        </button>\n      )}\n    </div>\n  );\n}\n"],"mappings":"AAAA,OAASA,OAAO,KAAQ,kBAAkB,CAC1C,OAASC,OAAO,KAAQ,wBAAwB,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEjD,KAAM,CAAAC,GAAG,CAAG,CACV,CAAC,SAAS,CAAE,GAAG,CAAC,CAChB,CAAC,cAAc,CAAE,SAAS,CAAC,CAC3B,CAAC,YAAY,CAAE,YAAY,CAAC,CAC5B,CAAC,QAAQ,CAAE,cAAc,CAAC,CAC1B,CAAC,WAAW,CAAE,YAAY,CAAC,CAC3B,CAAC,cAAc,CAAE,cAAc,CAAC,CAChC,CAAC,YAAY,CAAE,UAAU,CAAC,CAC1B,CAAC,SAAS,CAAE,UAAU,CAAC,CACxB,CAED,cAAe,SAAS,CAAAC,MAAMA,CAAAC,IAAA,CAAe,IAAd,CAAEC,QAAS,CAAC,CAAAD,IAAA,CACzC,KAAM,CAAEE,IAAI,CAAEC,MAAM,CAAEC,KAAK,CAAEC,QAAS,CAAC,CAAGZ,OAAO,CAAC,CAAC,CAEnD,mBACEI,KAAA,QAAKS,SAAS,CAAC,OAAO,CAAAL,QAAA,eACpBJ,KAAA,UAAOS,SAAS,CAAC,SAAS,CAAAL,QAAA,eACxBN,IAAA,QAAKW,SAAS,CAAC,OAAO,CAAAL,QAAA,CAAC,UAAQ,CAAK,CAAC,cACrCN,IAAA,QAAAM,QAAA,CACGH,G