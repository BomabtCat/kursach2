# Public address of your Yandex Cloud VM or domain.
# Examples:
# PUBLIC_HOST=158.160.10.20
# PUBLIC_HOST=it-infra.example.ru
PUBLIC_HOST=YOUR_VM_PUBLIC_IP

SERVER_PORT=5000
CLIENT_PORT=80
MONGO_PORT=27017

NODE_ENV=production
JWT_ACCESS_SECRET=change_this_long_access_secret
JWT_REFRESH_SECRET=change_this_long_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=refreshToken
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
